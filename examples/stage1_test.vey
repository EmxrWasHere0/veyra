# ---- Multiple return + destructuring ----
add divmod(a, b)
    return a / b, a % b
end

[q, r] = divmod(17, 5)
say q           # 3.4
say r           # 2

# ---- List destructuring ----
nums = [1, 2, 3, 4, 5]
[first, second, ...rest] = nums
say first       # 1
say second      # 2
say rest        # [3, 4, 5]

# ---- Rest at the end ----
[a, b, c] = [10, 20, 30]
say a + b + c   # 60

# ---- Conditional assignment ?= ----
set port = 80
say port                # 80
say 0 ? port            # 0 (channel empty)

port ?= 8080            # channel is empty, so assign
say 0 ? port            # 8080

port ?= 3000            # channel is full, so skip
say 0 ? port            # 8080 (unchanged)

# ---- ?= on normal variables ----
x = 5
x ?= 10
say x                   # 5 (already defined)

y ?= 42
say y                   # 42 (was undefined)

# ---- Tests (skipped in normal run) ----
add factorial(n)
    if n <= 1
        return 1
    end
    n * factorial(n - 1)
end

test "factorial basics"
    assert factorial(0) == 1
    assert factorial(1) == 1
    assert factorial(5) == 120
end

test "factorial of 10"
    assert factorial(10) == 3628800
end

test "destructuring works in tests"
    [a, b] = divmod(10, 3)
    assert a == 3.3333333333333335
    assert b == 1
end

say "Normal run complete (tests were skipped)"