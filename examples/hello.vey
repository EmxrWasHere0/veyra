set title = "Veyra Rust Interpreter"
say title

score = 85
if score >= 90
    say "Mükemmel!"
else if score >= 70
    say "Güzel!"
else
    say "Biraz daha çalış."
end

set status = "Sabit değer"
status = "Kanal değeri"
say status
say status ? ch

x = 0
repeat 5
    x += 1
    say x
    if x == 3
        stop
    end
end
