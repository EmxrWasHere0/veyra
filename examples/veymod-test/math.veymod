# math.veymod — Math utilities

set PI = 3.14159265358979
set E = 2.71828182845904
set TAU = 6.28318530717958

add square(x)
    x * x
end

add cube(x)
    x * x * x
end

add abs(x)
    if x < 0
        return 0 - x
    end
    x
end

add max(a, b)
    if a > b
        return a
    end
    b
end

add min(a, b)
    if a < b
        return a
    end
    b
end

add clamp(x, lo, hi)
    if x < lo
        return lo
    end
    if x > hi
        return hi
    end
    x
end

add factorial(n)
    if n <= 1
        return 1
    end
    n * factorial(n - 1)
end

add divide(a, b)
    a / b
end

add _double(x)
    x * 2
end

add quadruple(x)
    _double(_double(x))
end