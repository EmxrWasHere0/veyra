{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Veyra",
  "scopeName": "source.veyra",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#mod-statement" },
    { "include": "#labeled-loops" },
    { "include": "#function-definition" },
    { "include": "#lambda" },
    { "include": "#collection-loop" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#module-access" },
    { "include": "#function-call" },
    { "include": "#special-variables" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.veyra",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#interpolated-strings" },
        {
          "name": "string.quoted.triple.double.veyra",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.triple.single.veyra",
          "begin": "'''",
          "end": "'''",
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.double.veyra",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.single.veyra",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.veyra",
          "match": "\\\\(n|t|r|\\\\|\"|')"
        }
      ]
    },
    "interpolated-strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.interpolated.veyra",
          "begin": "(f)(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.veyra" },
            "2": { "name": "punctuation.definition.string.begin.veyra" }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.veyra" }
          },
          "patterns": [{ "include": "#interpolation-content" }]
        },
        {
          "name": "string.quoted.triple.single.interpolated.veyra",
          "begin": "(f)(''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.veyra" },
            "2": { "name": "punctuation.definition.string.begin.veyra" }
          },
          "end": "'''",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.veyra" }
          },
          "patterns": [{ "include": "#interpolation-content" }]
        },
        {
          "name": "string.quoted.double.interpolated.veyra",
          "begin": "(f)(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.veyra" },
            "2": { "name": "punctuation.definition.string.begin.veyra" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.veyra" }
          },
          "patterns": [{ "include": "#interpolation-content" }]
        },
        {
          "name": "string.quoted.single.interpolated.veyra",
          "begin": "(f)(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.veyra" },
            "2": { "name": "punctuation.definition.string.begin.veyra" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.veyra" }
          },
          "patterns": [{ "include": "#interpolation-content" }]
        }
      ]
    },
    "interpolation-content": {
      "patterns": [
        { "include": "#string-escapes" },
        {
          "name": "constant.character.escape.brace.veyra",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.veyra",
          "begin": "\\{(?!\\{)",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.veyra" }
          },
          "end": "\\}(?!\\})",
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.veyra" }
          },
          "patterns": [{ "include": "#expression" }]
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#lambda" },
        { "include": "#builtins" },
        { "include": "#module-access" },
        { "include": "#function-call" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.veyra",
          "match": "\\b\\d+(\\.\\d+)?\\b|\\.\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.veyra",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "mod-statement": {
      "patterns": [
        {
          "match": "^\\s*(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\[)([^\\]]*)(\\])",
          "captures": {
            "1": { "name": "keyword.control.import.veyra" },
            "2": { "name": "entity.name.namespace.veyra" },
            "3": { "name": "punctuation.definition.list.begin.veyra" },
            "4": {
              "patterns": [
                {
                  "name": "variable.other.imported.veyra",
                  "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                  "name": "punctuation.separator.comma.veyra",
                  "match": ","
                }
              ]
            },
            "5": { "name": "punctuation.definition.list.end.veyra" }
          }
        },
        {
          "match": "^\\s*(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\*)",
          "captures": {
            "1": { "name": "keyword.control.import.veyra" },
            "2": { "name": "entity.name.namespace.veyra" },
            "3": { "name": "keyword.operator.wildcard.veyra" }
          }
        },
        {
          "match": "^\\s*(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.import.veyra" },
            "2": { "name": "entity.name.namespace.veyra" }
          }
        }
      ]
    },
    "labeled-loops": {
      "patterns": [
        {
          "match": "(^\\s*)(@)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s+repeat\\b)",
          "captures": {
            "2": { "name": "punctuation.definition.label.veyra" },
            "3": { "name": "entity.name.label.veyra" }
          }
        },
        {
          "match": "\\b(stop|fwd)\\b\\s+(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.veyra" },
            "2": { "name": "punctuation.definition.label.veyra" },
            "3": { "name": "entity.name.label.veyra" }
          }
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(add|func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.declaration.function.veyra" },
            "2": { "name": "entity.name.function.veyra" },
            "3": { "name": "punctuation.definition.parameters.begin.veyra" }
          }
        }
      ]
    },
    "lambda": {
      "patterns": [
        {
          "match": "\\b(func)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.declaration.veyra" },
            "2": { "name": "punctuation.definition.parameters.begin.veyra" }
          }
        },
        {
          "name": "keyword.operator.arrow.veyra",
          "match": "=>"
        }
      ]
    },
    "collection-loop": {
      "patterns": [
        {
          "match": "\\b(repeat)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.loop.veyra" },
            "2": { "name": "variable.other.loop.veyra" },
            "3": { "name": "keyword.operator.membership.veyra" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.veyra",
          "match": "\\b(if|else|end|repeat|while|stop|fwd|return|try|catch|throw|test)\\b"
        },
        {
          "name": "keyword.declaration.veyra",
          "match": "\\b(set|add|func)\\b"
        },
        {
          "name": "keyword.other.veyra",
          "match": "\\b(say|get|assert)\\b"
        },
        {
          "name": "keyword.operator.logical.veyra",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.membership.veyra",
          "match": "\\bin\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.veyra",
          "match": "\\b(len|num|text|type)\\b(?=\\s*\\()"
        }
      ]
    },
    "module-access": {
      "patterns": [
        {
          "match": "\\b(system|io|base|json|http|websocket|math|time|fs|random)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "support.class.module.builtin.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "support.function.module.veyra" }
          }
        },
        {
          "match": "\\b(system|io|base|json|http|websocket|math|time|fs|random)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "support.class.module.builtin.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "support.constant.module.veyra" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)(append|pop|len|index|insert|remove|clear|reverse|sort|map|filter|reduce|any|all|upper|lower|trim|trim_start|trim_end|contains|starts_with|ends_with|replace|split|join|keys|values|has|get|merge|items)(?=\\s*\\()",
          "captures": {
            "1": { "name": "variable.other.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "support.function.method.veyra" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "entity.name.function.module.veyra" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "variable.other.member.veyra" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.veyra" }
          }
        }
      ]
    },
    "special-variables": {
      "patterns": [
        {
          "name": "variable.language.veyra",
          "match": "\\b_input\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.null-coalescing.veyra",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.assignment.conditional.veyra",
          "match": "\\?="
        },
        {
          "name": "keyword.operator.assignment.compound.veyra",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.channel.veyra",
          "match": "\\?(?![?=])"
        },
        {
          "name": "keyword.operator.spread.veyra",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.veyra",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.veyra",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.veyra",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "punctuation.accessor.dot.veyra",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.list.begin.veyra",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.list.end.veyra",
          "match": "\\]"
        },
        {
          "name": "punctuation.definition.jsondata.begin.veyra",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.jsondata.end.veyra",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.key-value.veyra",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.veyra",
          "match": ","
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.veyra",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
