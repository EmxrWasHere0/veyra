{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Veyra",
  "scopeName": "source.veyra",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#mod-statement" },
    { "include": "#labeled-loops" },
    { "include": "#keywords" },
    { "include": "#function-definition" },
    { "include": "#lambda" },
    { "include": "#module-access" },
    { "include": "#function-call" },
    { "include": "#builtins" },
    { "include": "#special-variables" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.veyra",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.veyra",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.veyra",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        },
        {
          "name": "string.quoted.single.veyra",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.veyra",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.veyra",
          "match": "\\b\\d+(\\.\\d+)?\\b|\\.\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.veyra",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "mod-statement": {
      "patterns": [
        {
          "comment": "Selective module import: mod system [get_env, args]",
          "match": "^\\s*(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\[)([^\\]]*)(\\])",
          "captures": {
            "1": { "name": "keyword.control.import.veyra" },
            "2": { "name": "entity.name.namespace.veyra" },
            "3": { "name": "punctuation.definition.list.begin.veyra" },
            "4": {
              "patterns": [
                {
                  "name": "variable.other.imported.veyra",
                  "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                  "name": "punctuation.separator.comma.veyra",
                  "match": ","
                }
              ]
            },
            "5": { "name": "punctuation.definition.list.end.veyra" }
          }
        },
        {
          "comment": "Wildcard module import: mod base *",
          "match": "^\\s*(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\*)",
          "captures": {
            "1": { "name": "keyword.control.import.veyra" },
            "2": { "name": "entity.name.namespace.veyra" },
            "3": { "name": "keyword.operator.wildcard.veyra" }
          }
        },
        {
          "comment": "Simple module import: mod system",
          "match": "^\\s*(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.import.veyra" },
            "2": { "name": "entity.name.namespace.veyra" }
          }
        }
      ]
    },
    "labeled-loops": {
      "patterns": [
        {
          "comment": "Labeled loop: @outer repeat",
          "match": "(^\\s*)(@)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s+repeat\\b)",
          "captures": {
            "2": { "name": "punctuation.definition.label.veyra" },
            "3": { "name": "entity.name.label.veyra" }
          }
        },
        {
          "comment": "Labeled loop control: stop @outer or fwd @outer",
          "match": "\\b(stop|fwd)\\b\\s+(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.veyra" },
            "2": { "name": "punctuation.definition.label.veyra" },
            "3": { "name": "entity.name.label.veyra" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.veyra",
          "match": "\\b(if|else|end|repeat|while|stop|fwd|return|try|catch)\\b"
        },
        {
          "name": "keyword.declaration.veyra",
          "match": "\\b(set|add|func)\\b"
        },
        {
          "name": "keyword.other.veyra",
          "match": "\\b(say|get|assert)\\b"
        },
        {
          "name": "keyword.operator.logical.veyra",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(add)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.declaration.veyra" },
            "2": { "name": "entity.name.function.veyra" },
            "3": { "name": "punctuation.definition.parameters.begin.veyra" }
          }
        }
      ]
    },
    "lambda": {
      "patterns": [
        {
          "match": "\\b(func)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.declaration.veyra" },
            "2": { "name": "punctuation.definition.parameters.begin.veyra" }
          }
        },
        {
          "name": "keyword.operator.arrow.veyra",
          "match": "=>"
        }
      ]
    },
    "module-access": {
      "patterns": [
        {
          "comment": "Built-in module function call",
          "match": "\\b(system|io|base)(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "support.class.module.builtin.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "support.function.module.veyra" }
          }
        },
        {
          "comment": "Built-in module member access",
          "match": "\\b(system|io|base)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "support.class.module.builtin.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "support.constant.module.veyra" }
          }
        },
        {
          "comment": "Generic module function call",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "entity.name.function.module.veyra" }
          }
        },
        {
          "comment": "Generic module member access",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.veyra" },
            "2": { "name": "punctuation.accessor.dot.veyra" },
            "3": { "name": "variable.other.member.veyra" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.veyra" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.veyra",
          "match": "\\b(len|num|text|type)\\b(?=\\s*\\()"
        }
      ]
    },
    "special-variables": {
      "patterns": [
        {
          "name": "variable.language.veyra",
          "match": "\\b_input\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Null-coalescing operator",
          "name": "keyword.operator.null-coalescing.veyra",
          "match": "\\?\\?"
        },
        {
          "comment": "Conditional assignment operator",
          "name": "keyword.operator.assignment.conditional.veyra",
          "match": "\\?="
        },
        {
          "comment": "Channel operator",
          "name": "keyword.operator.channel.veyra",
          "match": "\\?(?![?=])"
        },
        {
          "name": "keyword.operator.spread.veyra",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.veyra",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.augmented.veyra",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.assignment.veyra",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.veyra",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "punctuation.accessor.dot.veyra",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.veyra",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
