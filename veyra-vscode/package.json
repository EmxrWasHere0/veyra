{
  "name": "veyra",
  "displayName": "Veyra",
  "description": "Syntax highlighting and language support for the Veyra programming language.",
  "version": "0.2.6",
  "publisher": "veyra-lang",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "veyra",
    "vey",
    "syntax-highlighting",
    "language-support",
    "repl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EmxrWasHere0/veyra.git"
  },
  "files": [
    "README.md",
    "package.json",
    "extension.js",
    "icons/**",
    "syntaxes/**",
    "snippets/**",
    "language-configuration.json",
    "LICENSE"
  ],
  "icon": "icons/veyra.png",
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:veyra.startREPL"
  ],
  "contributes": {
    "languages": [
      {
        "id": "veyra",
        "aliases": [
          "Veyra",
          "veyra"
        ],
        "extensions": [
          ".vey",
          ".veyra",
          ".vy",
          ".veymod",
          ".wei"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/veyra.png",
          "dark": "./icons/veyra.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "veyra",
        "scopeName": "source.veyra",
        "path": "./syntaxes/veyra.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "veyra",
        "path": "./snippets/veyra.json"
      }
    ],
    "commands": [
      {
        "command": "veyra.startREPL",
        "title": "Start REPL",
        "category": "Veyra"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
