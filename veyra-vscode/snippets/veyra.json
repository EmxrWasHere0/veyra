{
  "mod import": {
    "prefix": "mod",
    "body": ["mod ${1:name}", "$0"],
    "description": "Import a Veyra module"
  },
  "mod star import": {
    "prefix": "mods",
    "body": ["mod ${1:name} *", "$0"],
    "description": "Import all available members from a module"
  },
  "mod selective import": {
    "prefix": "modi",
    "body": ["mod ${1:name} [${2:member1}, ${3:member2}]", "$0"],
    "description": "Import selected members from a module"
  },
  "mod system": {
    "prefix": "modsys",
    "body": ["mod system", "$0"],
    "description": "Import the system module"
  },
  "mod system star import": {
    "prefix": "modsyss",
    "body": ["mod system *", "$0"],
    "description": "Import all system module members"
  },
  "mod system selective import": {
    "prefix": "modsysi",
    "body": ["mod system [${1:get_env}, ${2:args}]", "$0"],
    "description": "Import selected members from the system module"
  },
  "mod io": {
    "prefix": "modio",
    "body": ["mod io", "$0"],
    "description": "Import the io module"
  },
  "mod io star import": {
    "prefix": "modios",
    "body": ["mod io *", "$0"],
    "description": "Import all io module members"
  },
  "mod io selective import": {
    "prefix": "modioi",
    "body": ["mod io [${1:read}, ${2:write}]", "$0"],
    "description": "Import selected members from the io module"
  },
  "mod base": {
    "prefix": "modbase",
    "body": ["mod base", "$0"],
    "description": "Import the base module"
  },
  "mod base star import": {
    "prefix": "modbases",
    "body": ["mod base *", "$0"],
    "description": "Import all base module members"
  },
  "mod base selective import": {
    "prefix": "modbasei",
    "body": ["mod base [${1:hostname}, ${2:pid}]", "$0"],
    "description": "Import selected members from the base module"
  },
  "mod json": {
    "prefix": "modjson",
    "body": ["mod json", "$0"],
    "description": "Import the JSON module"
  },
  "mod http": {
    "prefix": "modhttp",
    "body": ["mod http", "$0"],
    "description": "Import the HTTP module"
  },
  "mod websocket": {
    "prefix": "modws",
    "body": ["mod websocket", "$0"],
    "description": "Import the WebSocket module"
  },
  "mod math": {
    "prefix": "modmath",
    "body": ["mod math", "$0"],
    "description": "Import the math module"
  },
  "mod time": {
    "prefix": "modtime",
    "body": ["mod time", "$0"],
    "description": "Import the time module"
  },
  "mod fs": {
    "prefix": "modfs",
    "body": ["mod fs", "$0"],
    "description": "Import the filesystem module"
  },
  "mod random": {
    "prefix": "modrandom",
    "body": ["mod random", "$0"],
    "description": "Import the random module"
  },
  "add variable": {
    "prefix": "add",
    "body": ["add ${1:name} = ${2:value}", "$0"],
    "description": "Declare a mutable variable"
  },
  "set constant": {
    "prefix": "set",
    "body": ["set ${1:name} = ${2:value}", "$0"],
    "description": "Declare a constant and channel"
  },
  "say": {
    "prefix": "say",
    "body": ["say ${1:value}", "$0"],
    "description": "Print a value"
  },
  "get input": {
    "prefix": "get",
    "body": ["get ${1:name} \"${2:Enter a value: }\"", "$0"],
    "description": "Read user input with a prompt"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condition}", "    $0", "end"],
    "description": "Create an if block"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}",
      "    ${2:statement}",
      "else",
      "    $0",
      "end"
    ],
    "description": "Create an if-else block"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition}", "    $0", "end"],
    "description": "Create a while loop"
  },
  "repeat": {
    "prefix": "repeat",
    "body": ["repeat ${1:count}", "    $0", "end"],
    "description": "Repeat a block a fixed number of times"
  },
  "repeat collection": {
    "prefix": "repeatin",
    "body": ["repeat ${1:item} in ${2:collection}", "    $0", "end"],
    "description": "Iterate over a collection"
  },
  "repeat labeled": {
    "prefix": "repeatlabel",
    "body": ["@${1:outer} repeat ${2:count}", "    $0", "end"],
    "description": "Create a labeled repeat loop"
  },
  "stop": {
    "prefix": "stop",
    "body": ["stop${1: @outer}$0"],
    "description": "Stop a loop, optionally by label"
  },
  "fwd": {
    "prefix": "fwd",
    "body": ["fwd${1: @outer}$0"],
    "description": "Continue a loop, optionally by label"
  },
  "function": {
    "prefix": "func",
    "body": ["add ${1:name}(${2:params})", "    $0", "end"],
    "description": "Declare a Veyra function"
  },
  "lambda": {
    "prefix": "lambda",
    "body": ["func(${1:params}) => ${2:expression}$0"],
    "description": "Create a lambda expression"
  },
  "return": {
    "prefix": "return",
    "body": ["return ${1:value}$0"],
    "description": "Return a value from a function"
  },
  "try catch": {
    "prefix": "try",
    "body": ["try", "    ${1:statement}", "catch ${2:error}", "    $0", "end"],
    "description": "Handle runtime errors"
  },
  "throw": {
    "prefix": "throw",
    "body": ["throw ${1:\"Error message\"}$0"],
    "description": "Throw a runtime error"
  },
  "test": {
    "prefix": "test",
    "body": ["test ${1:name}", "    $0", "end"],
    "description": "Declare a test block"
  },
  "assert": {
    "prefix": "assert",
    "body": ["assert ${1:condition}$0"],
    "description": "Assert that a condition is true"
  },
  "list": {
    "prefix": "list",
    "body": ["add ${1:items} = [${2:1, 2, 3}]$0"],
    "description": "Create a list"
  },
  "jsondata": {
    "prefix": "jsondata",
    "body": ["add ${1:data} = {", "    \"${2:key}\": ${3:value}", "}$0"],
    "description": "Create a JSON-like object"
  },
  "multiline string": {
    "prefix": "multistr",
    "body": ["add ${1:text} = \"\"\"", "${2:Text goes here}", "\"\"\"$0"],
    "description": "Create a multiline string"
  },
  "interpolated string": {
    "prefix": "fstr",
    "body": ["f\"${1:Hello, }{${2:name}}${3:!}\"$0"],
    "description": "Create an interpolated string"
  },
  "interpolated multiline string": {
    "prefix": "fmultistr",
    "body": [
      "add ${1:message} = f\"\"\"",
      "${2:Hello, }{${3:name}}",
      "\"\"\"$0"
    ],
    "description": "Create a multiline interpolated string"
  },
  "list map": {
    "prefix": "map",
    "body": ["${1:items}.map(func(${2:item}) => ${3:item * 2})$0"],
    "description": "Transform list elements using a callback"
  },
  "list filter": {
    "prefix": "filter",
    "body": ["${1:items}.filter(func(${2:item}) => ${3:item > 0})$0"],
    "description": "Filter list elements using a callback"
  },
  "list reduce": {
    "prefix": "reduce",
    "body": [
      "${1:items}.reduce(func(${2:acc}, ${3:item}) => ${4:acc + item}, ${5:0})$0"
    ],
    "description": "Reduce a list to a single value"
  },
  "list any": {
    "prefix": "any",
    "body": ["${1:items}.any(func(${2:item}) => ${3:item > 0})$0"],
    "description": "Check whether any list element matches a condition"
  },
  "list all": {
    "prefix": "all",
    "body": ["${1:items}.all(func(${2:item}) => ${3:item > 0})$0"],
    "description": "Check whether all list elements match a condition"
  },
  "jsondata merge": {
    "prefix": "merge",
    "body": ["${1:data}.merge(${2:other})$0"],
    "description": "Merge two JSONData objects"
  },
  "jsondata items": {
    "prefix": "items",
    "body": ["${1:data}.items()$0"],
    "description": "Get JSONData key-value pairs as a list"
  }
}
