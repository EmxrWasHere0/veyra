{
  "mod import": {
    "prefix": "mod",
    "body": ["mod ${1:name}"],
    "description": "Load a module"
  },
  "mod star import": {
    "prefix": "mods",
    "body": ["mod ${1:name} *"],
    "description": "Star import a module"
  },
  "mod selective import": {
    "prefix": "modi",
    "body": ["mod ${1:name} [${2:member1}, ${3:member2}]"],
    "description": "Selective import from a module"
  },
  "mod system": {
    "prefix": "modsys",
    "body": ["mod system", "$0"],
    "description": "Import the system module"
  },
  "mod io": {
    "prefix": "modio",
    "body": ["mod io", "$0"],
    "description": "Import the io module"
  },
  "mod base": {
    "prefix": "modbase",
    "body": ["mod base", "$0"],
    "description": "Import the base module"
  }
}
