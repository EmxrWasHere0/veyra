{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string", "comment"]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:@[a-zA-Z_][a-zA-Z0-9_]*\\s+)?(?:if|else\\s+if|else|repeat(?:\\s+while)?|add)\\b.*|try\\b.*|catch(?:\\s+\\w+)?\\b.*)$",
    "decreaseIndentPattern": "^\\s*(?:end\\b|else(?:\\s+if\\b)?|catch(?:\\s+\\w+)?\\b).*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(?:(?:@[a-zA-Z_][a-zA-Z0-9_]*\\s+)?(?:if|repeat(?:\\s+while)?|add)\\b|try\\b|catch(?:\\s+\\w+)?\\b)",
      "end": "^\\s*end\\s*$"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:@[a-zA-Z_][a-zA-Z0-9_]*\\s+)?(?:if|else\\s+if|else|repeat(?:\\s+while)?|add)\\b.*|try\\b.*|catch(?:\\s+\\w+)?\\b.*)$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:else(?:\\s+if)?|catch(?:\\s+\\w+)?)\\b.*$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
