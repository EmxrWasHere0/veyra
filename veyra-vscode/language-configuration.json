{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string", "comment"]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:if|else\\s+if|else|while|try|catch)\\b.*|(?:@[a-zA-Z_][a-zA-Z0-9_]*\\s+)?repeat\\b.*|(?:add|func)\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*\\([^)]*\\)\\s*(?:#.*)?)$",
    "decreaseIndentPattern": "^\\s*(?:end\\b|else(?:\\s+if\\b)?|catch\\b).*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(?:(?:if|while|try)\\b|(?:@[a-zA-Z_][a-zA-Z0-9_]*\\s+)?repeat\\b|(?:add|func)\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*\\(|else\\b|catch\\b)",
      "end": "^\\s*end\\s*(?:#.*)?$"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:if|else\\s+if|else|while|try|catch)\\b.*|(?:@[a-zA-Z_][a-zA-Z0-9_]*\\s+)?repeat\\b.*|(?:add|func)\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*\\([^)]*\\)\\s*(?:#.*)?)$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
